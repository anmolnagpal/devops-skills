{
  "format_version": "1.2",
  "terraform_version": "1.14.3",
  "resource_changes": [
    {
      "address": "aws_db_instance.main",
      "type": "aws_db_instance",
      "name": "main",
      "provider_name": "registry.terraform.io/hashicorp/aws",
      "change": {
        "actions": [
          "delete",
          "create"
        ],
        "replace_paths": [
          [
            "availability_zone"
          ]
        ],
        "before": {
          "identifier": "prod-payments-db",
          "availability_zone": "eu-west-1a",
          "allocated_storage": 200,
          "engine": "postgres",
          "engine_version": "16.4",
          "skip_final_snapshot": true,
          "final_snapshot_identifier": null,
          "tags": {
            "Environment": "prod",
            "Team": "payments"
          }
        },
        "after": {
          "identifier": "prod-payments-db",
          "availability_zone": "eu-west-1b",
          "allocated_storage": 200,
          "engine": "postgres",
          "engine_version": "16.4",
          "skip_final_snapshot": true,
          "final_snapshot_identifier": null,
          "tags": {
            "Environment": "prod",
            "Team": "payments"
          }
        }
      }
    },
    {
      "address": "aws_cloudwatch_log_group.api",
      "type": "aws_cloudwatch_log_group",
      "name": "api",
      "change": {
        "actions": [
          "create"
        ],
        "before": null,
        "after": {
          "name": "/aws/eks/prod/api",
          "retention_in_days": 30
        }
      }
    },
    {
      "address": "aws_security_group_rule.api_ingress_legacy",
      "type": "aws_security_group_rule",
      "name": "api_ingress_legacy",
      "change": {
        "actions": [
          "delete"
        ],
        "before": {
          "type": "ingress",
          "from_port": 8080,
          "to_port": 8080,
          "protocol": "tcp",
          "cidr_blocks": [
            "10.0.0.0/8"
          ],
          "description": "added by hand during the incident on 2026-06-14"
        },
        "after": null
      }
    }
  ],
  "configuration": {
    "provider_config": {
      "aws": {
        "name": "aws",
        "version_constraint": "~> 6.0"
      }
    }
  },
  "variables": {
    "environment": {
      "value": "prod"
    }
  }
}
