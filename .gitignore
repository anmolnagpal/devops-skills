# Terraform
*.tfstate
*.tfstate.backup
*.tfstate.lock.info
.terraform/
.terraform.lock.hcl
terraform.tfvars
*.auto.tfvars
crash.log
override.tf
override.tf.json

# Secrets and local config
.env
.env.*

# Private key material. This repo ships a skill (appsec, SEC-SEC-004) that flags a
# committed private key, and had no rule against committing one itself.
*.pem
*.key
*.p12
*.pfx
*.jks
id_rsa
id_ed25519
id_ecdsa
*.local
CLAUDE.local.md

# macOS
.DS_Store

# Editor
.vscode/
.idea/
*.swp

# Cursor adapters are generated (scripts/generate.sh) and MUST be committed.
# Re-include them here so a global ~/.gitignore that ignores `.cursor/` cannot
# drop them. The directory must be re-included before the files within it.
!.cursor/
!.cursor/rules/
!.cursor/rules/*.mdc

# Eval fixtures are the exception: the tf skill's TF-STATE-003 rule detects a
# committed .tfstate, so proving it needs a committed .tfstate. Without this
# negation the fixture is ignored, the case ships without its input, and the
# behavioral eval fails with "no fixture file found" for everyone but the author.
!skills/*/evals/cases/*/*.tfstate
!skills/*/evals/cases/*/*.tfstate.backup
# Same reasoning for the appsec fixtures: SEC-SEC-003 detects a committed .env and
# SEC-SEC-004 a committed private key, so proving either needs the file present. The
# values inside are inert placeholders, not credentials.
!skills/*/evals/cases/*/.env
!skills/*/evals/cases/*/.env.*
!skills/*/evals/cases/*/*.key
!skills/*/evals/cases/*/*.pem
